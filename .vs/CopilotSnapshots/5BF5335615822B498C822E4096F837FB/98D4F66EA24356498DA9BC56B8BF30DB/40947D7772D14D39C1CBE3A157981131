using Microsoft.AspNetCore.Components.WebAssembly.Hosting;
using MudBlazor.Services;
using Microsoft.AspNetCore.Components.WebAssembly.Http;
using System.Net.Http;

var builder = WebAssemblyHostBuilder.CreateDefault(args);

builder.Services.AddMudServices();

// Configure an HttpClient for server API calls that includes credentials (cookies)
var oauthRedirect = builder.Configuration["OAuth:RedirectUri"] ?? string.Empty;
var serverBase = string.Empty;
if (!string.IsNullOrEmpty(oauthRedirect))
{
    try { serverBase = new Uri(oauthRedirect).GetLeftPart(UriPartial.Authority); } catch { serverBase = string.Empty; }
}
if (string.IsNullOrEmpty(serverBase)) serverBase = builder.HostEnvironment.BaseAddress;

builder.Services.AddScoped(sp => new HttpClient(new BrowserHttpHandler { FetchCredentials = FetchCredentials.Include }) { BaseAddress = new Uri(serverBase) });

await builder.Build().RunAsync();
