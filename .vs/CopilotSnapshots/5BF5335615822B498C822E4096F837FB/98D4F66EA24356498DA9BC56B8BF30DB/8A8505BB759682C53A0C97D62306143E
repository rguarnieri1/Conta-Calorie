@using MudBlazor
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-space-between align-center">
            <div>
                <a href="/">Home</a>
            </div>
            <div>
                @if (isLoggedIn)
                {
                    <MudText Typo="Typo.body1" Class="mr-2">@UserDisplay</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Logout">Logout</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="NavigateToLogin">Login</MudButton>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isLoggedIn = false;
    private string UserDisplay = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "auth_user");
            if (!string.IsNullOrEmpty(json))
            {
                var user = JsonSerializer.Deserialize<AuthUser>(json);
                if (user is not null)
                {
                    isLoggedIn = true;
                    UserDisplay = $"{user.name} ({user.provider})";
                }
            }
        }
        catch { }
    }

    private async Task Logout()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "auth_user");
        }
        catch { }
        isLoggedIn = false;
        UserDisplay = string.Empty;
        StateHasChanged();
        NavManager.NavigateTo("/");
    }

    private class AuthUser
    {
        public string provider { get; set; }
        public string name { get; set; }
        public string email { get; set; }
    }
}
