@page "/login"

@using MudBlazor

<PageTitle>Login</PageTitle>

<MudContainer Class="mt-6">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-6">
                <MudText Typo="Typo.h5">Benvenuto</MudText>
                <MudText Typo="Typo.body2">Accedi per gestire i tuoi pasti, monitorare i progressi e migliorare le abitudini alimentari.</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-6">
                <MudForm @ref="_form" OnValidSubmit="OnValidSubmit">
                    <MudTextField @bind-Value="Email" Label="Email" Required="true" For="@(()=>Email)" />
                    <MudTextField @bind-Value="Password" Label="Password" InputType="InputType.Password" Required="true" For="@(()=>Password)" />

                    <div style="display:flex; justify-content:flex-start; gap:12px; margin-top:16px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Accedi</MudButton>
                    </div>

                    <MudDivider Class="my-4" />

                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoginWithFacebook">Accedi con Facebook</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoginWithGoogle">Accedi con Google</MudButton>
                    </div>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@inject NavigationManager NavManager
@inject IConfiguration Configuration

@code {
    private MudForm _form;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private async Task Submit()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                // TODO: eseguire autenticazione server-side via API
            }
        }
    }

    private Task OnValidSubmit() => Submit();

    private void LoginWithFacebook()
    {
        var fbClientId = Configuration["OAuth:FacebookClientId"] ?? string.Empty;
        var redirect = Configuration["OAuth:RedirectUri"] ?? NavManager.Uri;
        // Costruisce URL autorizzazione Facebook (server dovrà scambiare il code)
        var url = $"https://www.facebook.com/v15.0/dialog/oauth?client_id={Uri.EscapeDataString(fbClientId)}&redirect_uri={Uri.EscapeDataString(redirect)}&response_type=code&scope=email,public_profile";
        NavManager.NavigateTo(url, true);
    }

    private void LoginWithGoogle()
    {
        var googleClientId = Configuration["OAuth:GoogleClientId"] ?? string.Empty;
        var redirect = Configuration["OAuth:RedirectUri"] ?? NavManager.Uri;
        // Costruisce URL autorizzazione Google (Authorization Code flow)
        var url = $"https://accounts.google.com/o/oauth2/v2/auth?client_id={Uri.EscapeDataString(googleClientId)}&redirect_uri={Uri.EscapeDataString(redirect)}&response_type=code&scope=openid%20email%20profile&access_type=online&prompt=consent";
        NavManager.NavigateTo(url, true);
    }
}
