@page "/"

@using MudBlazor

<PageTitle>Home</PageTitle>

@* Layout con menu a sinistra e area centrale vuota. Le palette proposte sono qui sotto; premi "Applica" per cambiarle *@
<MudLayout>
    <MudDrawer Open="true" Anchor="Anchor.Start" Variant="DrawerVariant.Mini" Elevation="1" Style="background-color:@DrawerColor; color:@TextColor; min-width:200px;">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <!-- Voci di menu aggiuntive -->
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Style="background-color:@ContentColor; min-height:75vh; color:@TextColor;">
        <MudContainer Class="d-flex justify-center align-center" Style="height:60vh;">
            @* Spazio centrale vuoto, puoi inserire i tuoi componenti qui *@
            <div style="width:70%; height:80%; border:2px dashed rgba(0,0,0,0.12); display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.02);">
                <MudText Typo="Typo.h6">Area centrale (vuota)</MudText>
            </div>
        </MudContainer>

        <MudContainer Class="mt-4">
            <MudText Typo="Typo.h6">Palette suggerite</MudText>
            <MudGrid>
                @foreach (var p in Palettes)
                {
                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-2" Elevation="1">
                            <div style="display:flex; gap:12px; align-items:center;">
                                <div style="width:40px; height:40px; background:@p.Drawer; border-radius:6px; border:1px solid rgba(0,0,0,0.08);"></div>
                                <div style="width:40px; height:40px; background:@p.Content; border-radius:6px; border:1px solid rgba(0,0,0,0.08);"></div>
                                <div style="flex:1;">
                                    <div>@p.Name</div>
                                    <div style="font-size:0.85rem; color:rgba(0,0,0,0.6)">Drawer: @p.Drawer • Content: @p.Content</div>
                                </div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(()=>ApplyPalette(p))">Applica</MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Palette semplici come esempio. I colori sono espressi in hex per compatibilità con la versione MudBlazor in uso.
    private record PaletteOption(string Name, string Drawer, string Content, string Text);

    private List<PaletteOption> Palettes = new()
    {
        new("Chiaro", "#F5F5F5", "#FFFFFF", "#000000"),
        new("Scuro", "#263238", "#37474F", "#FFFFFF"),
        new("Primario", "#1565C0", "#E3F2FD", "#0D47A1")
    };

    private string DrawerColor = "#F5F5F5";
    private string ContentColor = "#FFFFFF";
    private string TextColor = "#000000";

    private void ApplyPalette(PaletteOption p)
    {
        DrawerColor = p.Drawer;
        ContentColor = p.Content;
        TextColor = p.Text;
    }
}
