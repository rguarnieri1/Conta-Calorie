@page "/"

@using MudBlazor

<PageTitle>Home</PageTitle>

<MudLayout>
    <MudDrawer Open="true" Anchor="Anchor.Start" Variant="DrawerVariant.Mini" Style="background-color:#f5f5f5">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
                <!-- Counter menu removed -->
