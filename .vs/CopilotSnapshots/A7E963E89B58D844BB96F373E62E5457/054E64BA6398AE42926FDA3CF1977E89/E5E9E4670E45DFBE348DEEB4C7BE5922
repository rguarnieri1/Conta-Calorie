@page "/"

@using MudBlazor

<PageTitle>Home</PageTitle>

<MudLayout>
    <MudDrawer Open="true" Anchor="Anchor.Start" Variant="DrawerVariant.Mini">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/counter">Counter</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer Class="mt-4">
            <MudText Typo="Typo.h4">Benvenuto</MudText>
            <p>Questa è la home page dell'app.</p>
        </MudContainer>
    </MudMainContent>
</MudLayout>
