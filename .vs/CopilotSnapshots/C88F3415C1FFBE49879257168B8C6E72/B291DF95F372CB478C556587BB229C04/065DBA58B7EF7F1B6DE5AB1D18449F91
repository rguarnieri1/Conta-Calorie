@page "/"

@using MudBlazor
@using System.Text.Json
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

@* Layout con menu a sinistra e area centrale vuota. Le palette proposte sono qui sotto; premi "Applica" per cambiarle *@
<MudLayout>
    <MudDrawer Open="true" Anchor="Anchor.Start" Variant="DrawerVariant.Mini" Elevation="1" Style="@($"background-color:{DrawerColor}; color:{TextColor}; min-width:200px;")">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <!-- Voci di menu aggiuntive -->
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Style="@($"background-color:{ContentColor}; min-height:75vh; color:{TextColor};")">
        @if (showAlert)
        {
            <MudContainer Class="mt-4">
                <MudAlert Severity="@alertSeverity" Elevation="0" Dense="true">@alertMessage</MudAlert>
            </MudContainer>
        }
        <MudContainer Class="d-flex justify-center align-center" Style="height:60vh;">
            @* Area centrale con messaggio introduttivo *@
            <div style="width:70%; height:80%; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
                <MudText Typo="Typo.h4" Class="mb-2">La salute inizia da ciò che mangi.</MudText>
                <MudText Typo="Typo.body1">Vuoi mangiare in maniera più consapevole? Monitora i pasti, impara le giuste abitudini e raggiungi i tuoi obiettivi con MyFitnessPal.</MudText>
                <div class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@NavigateToLogin">Accedi</MudButton>
                </div>
            </div>
        </MudContainer>

        @* Area 'Palette suggerite' rimossa come richiesto *@
    </MudMainContent>
</MudLayout>

@code {
    private bool showAlert = false;
    private Severity alertSeverity = Severity.Info;
    private string alertMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Parse query string for auth result or provider data
        var uri = new Uri(NavManager.Uri);
        var q = uri.Query;
        if (!string.IsNullOrEmpty(q))
        {
            var dict = new Dictionary<string, string>();
            var pairs = q.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in pairs)
            {
                var kv = p.Split('=', 2);
                var k = Uri.UnescapeDataString(kv[0]);
                var v = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
                dict[k] = v;
            }

            if (dict.TryGetValue("auth", out var auth))
            {
                showAlert = true;
                alertSeverity = auth == "error" || auth == "invalid_state" || auth == "invalid_token" ? Severity.Error : Severity.Warning;
                alertMessage = auth switch
                {
                    "error" => "Errore durante l'autenticazione.",
                    "invalid_state" => "Richiesta di autenticazione non valida (state mismatch).",
                    "invalid_token" => "Token di accesso non valido.",
                    _ => $"Stato autenticazione: {auth}"
                };
            }
            else if (dict.TryGetValue("provider", out var provider))
            {
                var email = dict.ContainsKey("email") ? dict["email"] : string.Empty;
                var name = dict.ContainsKey("name") ? dict["name"] : string.Empty;
                showAlert = true;
                alertSeverity = Severity.Success;
                alertMessage = $"Autenticazione riuscita con {provider}. Benvenuto {name} ({email}).";

                // Salva stato autenticazione sul client (localStorage)
                try
                {
                    var userObj = new { provider = provider, name = name, email = email };
                    await JS.InvokeVoidAsync("localStorage.setItem", "auth_user", JsonSerializer.Serialize(userObj));
                }
                catch { /* ignore JS errors */ }
            }

            // Rimuovi query string (replace history entry)
            NavManager.NavigateTo(uri.AbsolutePath, forceLoad: false, replace: true);
        }
    }

    // Colori applicati al layout (modifica direttamente se necessario)
    private string DrawerColor = "#F5F5F5";
    private string ContentColor = "#FFFFFF";
    private string TextColor = "#000000";
}
